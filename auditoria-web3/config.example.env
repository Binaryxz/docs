# Copie para config.env e preencha só o que for usar. Nunca faça commit do config.env.

# --- Chaves de API -----------------------------------------------------------
ANTHROPIC_API_KEY=          # revisões LLM: BridgeGuard, privacidade, zkTLS, governança
OPENAI_API_KEY=             # SymGPT
GITHUB_TOKEN=               # só para repositórios privados
# LLM_MODEL=                # modelo do Claude Code (padrão do CLI se vazio)

# --- Contratos ---------------------------------------------------------------
# MEDUSA_ALVOS=MeuInvariantTest      # contratos com property_*/invariant_* (auto-detecta se vazio)
# MEDUSA_TIMEOUT=900                 # segundos de fuzzing
# SYMGPT_MAX_ARQUIVOS=20

# --- Circuitos ZK ------------------------------------------------------------
# PICUS_SOLVER=z3                    # z3 | cvc5 | cvc4
# PICUS_SMT_TIMEOUT=5000             # ms por consulta SMT

# --- Privacidade -------------------------------------------------------------
# PRIVACY_SKILL_PATH=/caminho/SKILL.md   # skill privacy-protocol-auditor, se baixada

# --- Governança --------------------------------------------------------------
# ANTICAPTURE_MCP_API_KEY=           # pedir ao time da Anticapture
# DAO_ID=ENS
# DAO_ADDRESS=0x...
# DAO_CHAIN=ethereum
# Quorum (Certora): payloads de propostas já deployados
# ETHSCAN_API_KEY=
# QUORUM_PROTOCOLO=Aave
# QUORUM_REDE=Ethereum
# QUORUM_PAYLOADS=0xabc...,0xdef...

