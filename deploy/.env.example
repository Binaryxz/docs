# Copie este arquivo para .env e preencha os valores reais.
# NUNCA faça commit do arquivo .env (apenas .env.example vai para o Git).

# ---------------------------------------------------------------------------
# Domínio / TLS (Caddy)
# ---------------------------------------------------------------------------
DOMAIN=vendas.seudominio.com
ACME_EMAIL=gsantos@binaryxz.com

# ---------------------------------------------------------------------------
# n8n
# ---------------------------------------------------------------------------
N8N_HOST=vendas.seudominio.com
N8N_PROTOCOL=https
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=troque-esta-senha
N8N_ENCRYPTION_KEY=gere-com-openssl-rand-hex-32
WEBHOOK_URL=https://vendas.seudominio.com/

# ---------------------------------------------------------------------------
# OLMo 3 32B (servido via vLLM, API compatível com OpenAI)
# ---------------------------------------------------------------------------
OLMO_MODEL_ID=allenai/OLMo-3-32B
OLMO_API_KEY=gere-uma-chave-interna-qualquer
OLMO_MAX_MODEL_LEN=32768

# ---------------------------------------------------------------------------
# Conway Automaton (https://github.com/Conway-Research/automaton)
# Executa isolado nesta stack. Veja deploy/automaton/README.md para o
# checklist de restrições obrigatórias antes de rodar em produção.
# ---------------------------------------------------------------------------
# Endpoint local do OLMo, para o Automaton usar seu próprio modelo em vez de
# um provedor de nuvem externo (confirme a variável equivalente na config
# real do projeto antes do primeiro deploy).
AUTOMATON_INFERENCE_BASE_URL=http://olmo:8000/v1
AUTOMATON_INFERENCE_API_KEY=${OLMO_API_KEY}
# Carteira Ethereum usada pelo Automaton para sua identidade on-chain
# (ERC-8004 / Base). Gere uma carteira DEDICADA, sem fundos além do
# estritamente necessário. Nunca reutilize uma carteira pessoal/corporativa.
AUTOMATON_WALLET_PRIVATE_KEY=
AUTOMATON_ALLOW_SELF_REPLICATION=false
AUTOMATON_ALLOW_ONCHAIN_SPEND=false
AUTOMATON_APPROVAL_WEBHOOK_URL=http://n8n:5678/webhook/approval-request

# ---------------------------------------------------------------------------
# Chatwoot — Brasil
# ---------------------------------------------------------------------------
CHATWOOT_BR_BASE_URL=https://chatwoot-br.seudominio.com
CHATWOOT_BR_API_TOKEN=
CHATWOOT_BR_ACCOUNT_ID=

# ---------------------------------------------------------------------------
# Chatwoot — Europa
# ---------------------------------------------------------------------------
CHATWOOT_EU_BASE_URL=https://chatwoot-eu.seudominio.com
CHATWOOT_EU_API_TOKEN=
CHATWOOT_EU_ACCOUNT_ID=

# ---------------------------------------------------------------------------
# WhatsApp Business Cloud API
# ---------------------------------------------------------------------------
WHATSAPP_BR_PHONE_NUMBER_ID=
WHATSAPP_BR_ACCESS_TOKEN=
WHATSAPP_EU_PHONE_NUMBER_ID=
WHATSAPP_EU_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=defina-um-token-de-verificacao-do-webhook

# ---------------------------------------------------------------------------
# Meta Ads
# ---------------------------------------------------------------------------
META_ADS_ACCESS_TOKEN=
META_ADS_ACCOUNT_ID=

# ---------------------------------------------------------------------------
# Google Ads
# ---------------------------------------------------------------------------
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=

# ---------------------------------------------------------------------------
# E-mail (leitura/envio via IMAP/SMTP ou API do provedor)
# ---------------------------------------------------------------------------
EMAIL_IMAP_HOST=
EMAIL_IMAP_USER=
EMAIL_IMAP_PASSWORD=
EMAIL_SMTP_HOST=
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=
