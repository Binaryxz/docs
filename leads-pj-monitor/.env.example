# Copie este arquivo para ".env" e preencha antes de rodar "docker compose up".
# Nenhum valor aqui precisa ser editado depois — tudo o que muda com frequência
# (tribunais, filtros, pesos, chaves de provedor) fica na tela de Configurações.

# --- Banco de dados ---
POSTGRES_DB=leads_pj
POSTGRES_USER=leads_pj
POSTGRES_PASSWORD=troque_esta_senha

# --- Login da interface ---
# Senha de acesso ao sistema. Trocável depois na tela de Configurações.
APP_LOGIN_PASSWORD=troque_esta_senha_tambem

# --- Chave de criptografia das credenciais de provedor (FonteData/BigDataCorp) ---
# Gere uma com: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
APP_SECRET_KEY=

# --- DataJud (API Pública do CNJ) ---
# Obtenha a chave pública em https://datajud-wiki.cnj.jus.br/
DATAJUD_API_KEY=

# --- Fuso horário para agendamento diário ---
APP_TIMEZONE=America/Sao_Paulo
