# ─── Serviços opcionais ─────────────────────────────────────────────
# ollama | vllm, e opcionalmente omniroute e/ou n8n. Ex.: ollama,n8n
COMPOSE_PROFILES=ollama

# ─── Segredos (troque!) ─────────────────────────────────────────────
# Gere com: openssl rand -hex 24
RUNNER_TOKEN=troque-por-um-segredo
# Protege a UI/API. Vazio = sem login (só use assim com UI_BIND=127.0.0.1).
ADMIN_TOKEN=
# 127.0.0.1 = UI só nesta máquina; 0.0.0.0 = exposta na rede (defina ADMIN_TOKEN).
UI_BIND=127.0.0.1

# ─── LLM (OLMo 3) ───────────────────────────────────────────────────
# Qualquer endpoint OpenAI-compatível. Escolha UM bloco:

# 1) Ollama local (padrão). olmo-3.1:32b-instruct ≈ 19 GB, suporta tools.
LLM_BASE_URL=http://ollama:11434/v1
LLM_MODEL=olmo-3.1:32b-instruct
OLLAMA_MODEL=olmo-3.1:32b-instruct
LLM_API_KEY=ollama

# 2) vLLM com GPU (COMPOSE_PROFILES=vllm)
# LLM_BASE_URL=http://vllm:8000/v1
# LLM_MODEL=olmo-3-32b
# VLLM_MODEL=allenai/Olmo-3.1-32B-Instruct
# VLLM_TP=1
# LLM_API_KEY=local

# 3) OmniRoute na frente de Ollama/vLLM/provedores (COMPOSE_PROFILES=ollama,omniroute)
#    Cadastre o Ollama no dashboard (http://localhost:20128) com base URL
#    http://ollama:11434/v1 e copie a API key de Dashboard → Endpoints.
# LLM_BASE_URL=http://omniroute:20128/v1
# LLM_MODEL=ollama/olmo-3.1:32b-instruct
# LLM_API_KEY=sk-omniroute-...
# OMNIROUTE_PASSWORD=troque

# 4) Endpoint externo (ex.: OLMo servido em GPU na FluxEdge)
# LLM_BASE_URL=https://seu-endpoint/v1
# LLM_MODEL=allenai/Olmo-3.1-32B-Instruct
# LLM_API_KEY=...

LLM_TIMEOUT_S=600

# ─── Orquestração ───────────────────────────────────────────────────
# Tempo máximo que um run espera os agentes Automaton responderem.
RUN_TIMEOUT_S=1800
# Webhook chamado ao fim de cada run (ex.: http://n8n:5678/webhook/run-finalizado)
RUN_WEBHOOK_URL=
